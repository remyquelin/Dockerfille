
FROM python:3.13-slim

WORKDIR /app



RUN echo "from http.server import HTTPServer, SimpleHTTPRequestHandler; import sys; port = 9000; print(f'Serveur web démarré sur le port {port}'); HTTPServer(('0.0.0.0', port), SimpleHTTPRequestHandler).serve_forever()" > server.py


EXPOSE 9000

CMD ["python", "server.py"]
